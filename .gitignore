# ==============================================================================
# QUIRAL POS — Reglas de Exclusión de Git (.gitignore)
# ==============================================================================

# Dependencias y artefactos de compilación
node_modules/
dist/
dist-ssr/
*.local

# Variables de entorno y credenciales sensibles (Nivel de Seguridad Máximo)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Registros del sistema, OS y logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editores, IDEs y configuraciones locales
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Artefactos, logs y cachés de Herramientas y Entornos Auxiliares
.gemini/
.codex/
gemini-bundle/
.cursor/
.claude/
.cline/
.copilot/
ai-scratchpad/
ai-context-scratchpad/
*.pyc
__pycache__/
.pytest_cache/
.coverage
.agents/**/__pycache__/
.agents/**/*.pyc
.agents/**/.pytest_cache/
.agents/**/coverage/
.agents/**/*.log

# Frameworks de Testing y Reportes (Playwright, Vitest)
test-results/
/test-results/
playwright-report/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
coverage/
.vitest/

# Git hooks y build info
*.tsbuildinfo
.husky/_/
